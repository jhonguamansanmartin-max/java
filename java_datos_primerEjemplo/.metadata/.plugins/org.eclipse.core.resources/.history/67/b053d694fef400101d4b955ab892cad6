package com.krakedev;

public class Calculadora {
	public int sumar(int valor1, int valor2) {
		int resultado ; //siempre se declara la variable //
		resultado=valor1+valor2;
		return resultado;
		
	}
	
	public int restar(int valor1,int valor2) {
		int resultadoResta;
		resultadoResta=valor1-valor2;
		return resultadoResta;
		
	}
	
	public double multiplicar(double valor1,double valor2) {
		
		double resultadoMultiplicar;
		resultadoMultiplicar=valor1*valor2;
		return resultadoMultiplicar;
				
		
	}
	
	public double Dividir(double valor1,double valor2) {
		
		double resultadoDividir;
		resultadoDividir=valor1/valor2;
		return resultadoDividir;
		
	}
	
	
	public double Promediar(double valor1,double valor2, double valor3) { 
		double resultadoPromedio;
		resultadoPromedio=(valor1+valor2+valor3)/3 ;
		return resultadoPromedio;
		
		
	}
	
	public static void main(String[] args) {
		System.out.println("Ahorita no joven, Sali al almuerzo. Regreso en 15 min " );
	}

}
